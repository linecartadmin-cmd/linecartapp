# ==============================================================================
# LineCart Pilot & Staging Environment Configuration (.env.example)
# ==============================================================================

# 1. Execution Mode: 'development' or 'production'
# In 'production':
# - Only strong scrypt password hashes are accepted; known demo passwords are rejected
# - Demo user listing (/api/demo-users) and demo UI shortcuts are disabled
# - Strict HSTS & CORS origin policies are enforced
NODE_ENV=production

# 2. HTTP Server Port
PORT=3001

# 3. Persistent SQL Database Connection
# Supabase PostgreSQL: Use the Connection Pooler URI (Session Mode: port 5432, or Transaction Mode: port 6543)
# In Supabase Project Settings -> Database -> Connection string -> URI:
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# DB_SSL=true
# (Normal TLS verification is enabled by default. Supabase certificates are signed by trusted CAs, so DB_SSL_REJECT_UNAUTHORIZED is not needed.)
# DB_POOL_MAX=10
# If DATABASE_URL is omitted in local setups, LineCart automatically uses durable WAL SQL storage at server/data/linecart.pg.db

# 4. Durable Photo Storage (Supabase Storage)
# Required on ephemeral hosts like Render so uploaded shop photos survive server restarts and redeployments.
# In Supabase Dashboard -> Storage -> Create a new bucket named "shop-photos" (Private):
# SUPABASE_URL=https://[project-ref].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJh...[Service Role Secret from Project Settings -> API]
# SUPABASE_BUCKET=shop-photos
# If omitted, photos are saved to local server disk at server/uploads/shops/ (suitable for local dev only).

# 5. Reverse Proxy Support (Render, Cloudflare, etc.)
# Set to 'true' on cloud hosts so client IP rate-limiting accurately reads the real client IP via X-Forwarded-For.
TRUST_PROXY=true

# 6. Allowed CORS Origins (comma-separated list of HTTPS web & Capacitor origins)
CORS_ALLOWED_ORIGINS=https://linecart-backend.onrender.com,capacitor://localhost,https://localhost

# 7. Session & Login Rate-Limiting Controls
SESSION_TTL_MS=43200000
LOGIN_RATE_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=5

# 8. Initial Administrator Bootstrap (10-digit Indian mobile starting with 6-9 + strong password)
# Used only when no active Administrator account has a configured password hash.
INITIAL_ADMIN_PHONE=9870000001
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_8_CHARS
INITIAL_ADMIN_NAME=LineCart Administrator

# 9. Frontend / Capacitor API Base URL (used at Vite build time for Android APK or split hosting)
# Leave empty when serving the built React SPA from the same Express origin.
# For Android APK builds, set this to your live Render HTTPS URL:
# VITE_API_BASE_URL=https://linecart-backend.onrender.com

# 8. Map Tile Provider Configuration
# By default (without any API key), LineCart renders OpenStreetMap standard tiles (actual street tiles
# with roads and building outlines).
#
# To use CARTO Voyager or a commercial tile service in production:
# 1. Obtain a public map key from CARTO (https://carto.com/basemaps/apikey) or another provider.
# 2. IMPORTANT SECURITY NOTE: All VITE_* environment variables are compiled into the client-side bundle
#    and are visible to any app user. NEVER put private server secrets or master admin credentials here.
# 3. In your tile provider console, configure this key as a PUBLIC CLIENT KEY:
#    - Set Allowed HTTP Referrers / Domain restrictions:
#      https://staging.linecart.example.com/*, capacitor://localhost/*, http://localhost:3001/*
#    - Set Monthly Request Quotas / Rate Limits to prevent unauthorized usage or surprise charges.
#
# Examples:
# CARTO Voyager (Strictly requires an API key; requests without a key return an "API KEY REQUIRED" watermark):
# VITE_MAP_TILE_KEY=YOUR_PUBLIC_CARTO_API_KEY
#
# Custom Provider (e.g. MapTiler, Stadia Maps, or self-hosted tile server):
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key={key}
# VITE_MAP_TILE_KEY=YOUR_PUBLIC_MAPTILER_API_KEY
# VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://www.maptiler.com/copyright/">MapTiler</a>
# VITE_MAP_TILE_SUBDOMAINS=abc
