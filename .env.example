# ==============================================================================
# LineCart Pilot & Staging Environment Configuration (.env.example)
# ==============================================================================

# 1. Execution Mode: 'development' or 'production'
# In 'production':
# - Only strong scrypt password hashes are accepted; known demo passwords are rejected
# - Demo user listing (/api/demo-users) and demo UI shortcuts are disabled
# - Strict HSTS & CORS origin policies are enforced
NODE_ENV=production

# 2. HTTP Server Port
PORT=3001

# 3. Persistent SQL Database Connection
# Provide a PostgreSQL connection string for staging/production deployments:
# DATABASE_URL=postgresql://linecart_user:CHANGE_ME@db.staging.example.com:5432/linecart_prod
# DB_SSL=true
# DB_POOL_MAX=20
# If DATABASE_URL is omitted in local/single-node setups, LineCart uses durable WAL SQL storage at server/data/linecart.pg.db

# 4. Allowed CORS Origins (comma-separated list of HTTPS web & Capacitor origins)
CORS_ALLOWED_ORIGINS=https://staging.linecart.example.com,capacitor://localhost,https://localhost

# 5. Session & Login Rate-Limiting Controls
SESSION_TTL_MS=43200000
LOGIN_RATE_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=5

# 6. Initial Administrator Bootstrap (10-digit Indian mobile starting with 6-9 + strong password)
# Used only when no active Administrator account has a configured password hash.
INITIAL_ADMIN_PHONE=9870000001
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_8_CHARS
INITIAL_ADMIN_NAME=LineCart Administrator

# 7. Frontend / Capacitor API Base URL (used at Vite build time for Android APK or split hosting)
# Leave empty when serving the built React SPA from the same Express origin.
VITE_API_BASE_URL=https://staging.linecart.example.com
